{
	"name": "biome-json",
	"private": true,
	"license": "MIT",
	"type": "module",
	"bin": {
		"biome-json": "bin/biome-setup.ts",
		"biome-json-suppressions": "bin/biome-json-suppressions.mjs"
	},
	"exports": {
		"./strict": "./templates/strict.jsonc",
		"./package.json": "./package.json"
	},
	"files": [
